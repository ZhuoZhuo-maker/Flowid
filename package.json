{
  "name": "flowid",
  "author": "Flowid Team",
  "description": "Flowid 无限画布工作室",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n vite,auth -c blue,green \"vite\" \"node server/auth-server.cjs\"",
    "dev:vite": "vite",
    "points:dev": "node src/backend/server.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "auth:dev": "node server/auth-server.cjs",
    "auth:dev:open": "start \"\" \"http://127.0.0.1:3721/healthz\" && npm run auth:dev",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "gen:icon": "node scripts/generate-icon.mjs",
    "predesktop:build": "npm run gen:icon",
    "predesktop:dir": "npm run gen:icon",
    "desktop:build": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win nsis",
    "desktop:build:deliverables": "npm run desktop:build && node scripts/stage-deliverables.mjs",
    "pack": "npm run desktop:build:deliverables",
    "desktop:dir": "npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win dir",
    "analyzer:dev": "electron electron/analyzer-main.cjs",
    "analyzer:build": "cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win nsis --config electron-builder.analyzer.json",
    "export:bundled-gallery": "node scripts/export-flowid-bundled-gallery.mjs",
    "sync:user-agreement": "node scripts/sync-user-agreement-to-server.mjs",
    "gen:sensitive-lexicon": "node scripts/build-sensitive-lexicon.mjs",
    "build:lexicon": "node scripts/buildSensitiveLexicon.mjs",
    "test:sensitive": "vitest run src/lib/sensitiveEngine/sensitiveWords.test.ts",
    "bench:sensitive": "tsx scripts/bench-sensitive.ts",
    "gen-license": "node scripts/generate-licenses.mjs",
    "retry-dlq": "node scripts/retry-dlq.js",
    "test:points": "node tests/points.test.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "sql.js": "^1.14.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  },
  "flowidDesktop": {
    "disableAutoUpdate": true,
    "deliverablesLabel": "内测"
  },
  "build": {
    "appId": "com.flowid.desktop",
    "productName": "Flowid（内测版）",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "artifactName": "${productName}_v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Flowid（内测版）",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
