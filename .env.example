# Auth 服务（npm run auth:dev / npm run dev，默认端口 AUTH_SERVER_PORT=3721）
# 提供：预设模板、云端工作流目录、系统提示词、灵感小镇、用户协议、OpenAI 兼容代理等。
# 管理页：http://127.0.0.1:3721/admin.html（请求头 x-admin-token 或开发环境空口令）

# AUTH_SERVER_PORT=3721
# AUTH_ADMIN_SECRET=flowid-admin-dev

# --- 桌面端打包：设置 FLOWID_PUBLIC_SERVER 等后运行 npm run pack:desktop（见 scripts/run-pack-flowid-desktop.mjs）---
# VITE_FLOWID_PUBLIC_SERVER_ORIGIN=https://你的域名
# 授权页「交流群」：仅 QQ 群号数字（勿填会过期的分享链接）
# VITE_FLOWID_EXCHANGE_GROUP_QQ=1103016040

# 为 1 时：预设模板、灵感小镇、云端 Comfy 工作流从 public/flowid-bundled/ 随包读取
# VITE_FLOWID_LOCAL_GALLERY=1

# 导出 flowid-bundled：默认 http://127.0.0.1:3721（先 npm run auth:dev）
# FLOWID_EXPORT_GALLERY_BASE=https://host:3721

# 敏感词：VITE_FLOWID_SENSITIVE_FILTER=0|1；词库 FLOWID_LEXICON_MAX=2800
